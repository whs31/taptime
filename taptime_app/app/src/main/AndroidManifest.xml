<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:name=".TapTimeApplication" android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme" android:usesCleartextTraffic="false"
        android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".widgets.WidgetConfigurationActivity" android:exported="true" />
        <receiver android:name=".widgets.WidgetActionReceiver" android:exported="false" />
        <receiver android:name=".widgets.DashboardWidgetProvider" android:label="@string/widget_name_dashboard" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_dashboard_info" />
        </receiver>
        <receiver android:name=".widgets.DayTimelineWidgetProvider" android:label="@string/widget_name_day_timeline" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_day_timeline_info" />
        </receiver>
        <receiver android:name=".widgets.MonthBalanceWidgetProvider" android:label="@string/widget_name_month_balance" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_month_balance_info" />
        </receiver>
        <receiver android:name=".widgets.MonthRingWidgetProvider" android:label="@string/widget_name_month_ring" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_month_ring_info" />
        </receiver>
        <receiver android:name=".widgets.CompactWidgetProvider" android:label="@string/widget_name_compact" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_compact_info" />
        </receiver>
        <receiver android:name=".widgets.SmallWidgetProvider" android:label="@string/widget_name_small" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_small_info" />
        </receiver>
        <receiver android:name=".widgets.TinyWidgetProvider" android:label="@string/widget_name_tiny" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tiny_info" />
        </receiver>
    </application>
</manifest>
